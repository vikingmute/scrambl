{
  "name": "@scrambl/core",
  "version": "0.1.0",
  "description": "Zero-dependency text scramble animation engine",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": ["dist"],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "license": "MIT",
  "homepage": "https://scrambl.vikingz.me",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vikingmute/scrambl.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/vikingmute/scrambl/issues"
  },
  "keywords": [
    "scramble",
    "text",
    "animation",
    "effect",
    "reveal",
    "glitch",
    "typewriter",
    "decode"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "vitest": "^2.1.0"
  }
}
