{
  "name": "@scrambl/vue",
  "version": "0.1.0",
  "description": "Vue composables and components for @scrambl/core text scramble effects",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": ["dist"],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "license": "MIT",
  "homepage": "https://scrambl.vikingz.me",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vikingmute/scrambl.git",
    "directory": "packages/vue"
  },
  "bugs": {
    "url": "https://github.com/vikingmute/scrambl/issues"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@scrambl/core": "workspace:*"
  },
  "peerDependencies": {
    "vue": ">=3.3.0"
  },
  "devDependencies": {
    "vue": "^3.5.0",
    "tsup": "^8.3.0"
  }
}
